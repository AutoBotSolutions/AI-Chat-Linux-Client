# Chat Linux Client Environment Variables Example
# Copy this file to .env and fill in your API keys

# AI Provider API Keys
# Uncomment and set the keys for the providers you want to use

# Groq API Key (for ultra-low latency inference)
# GROQ_API_KEY=gsk_your_groq_api_key_here

# HuggingFace API Key (for open-source models)
# HUGGINGFACE_API_KEY=hf_your_huggingface_api_key_here

# OpenRouter API Key (for multi-model routing)
# OPENROUTER_API_KEY=sk-or-your_openrouter_api_key_here

# OpenAI API Key (if using OpenAI models)
# OPENAI_API_KEY=sk-your_openai_api_key_here

# Ollama Configuration
# OLLAMA_BASE_URL=http://localhost:11434

# Application Settings
# LOG_LEVEL=INFO
# THEME=dark
# FONT_SIZE=12

# Privacy Settings
# ENCRYPT_CHATS=false
# DISABLE_TELEMETRY=true

# Development Settings
# DEBUG=false
# LOG_TO_FILE=true
